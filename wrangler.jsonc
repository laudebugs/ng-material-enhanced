{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ng-material-enhanced",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist/cloudflare",
  "vars": {
    "NODE_VERSION": "22.22.3"
  },
  "observability": {
    "enabled": true
  },
}
