{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ng-material-enhanced",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    },
  },
  "assets": {
    "directory": "dist/ng-material-enhanced/browser"
  }
}
