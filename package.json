{
  "name": "ng-material-enhanced",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "generate:css": "node ./scripts/generate-css.mjs",
    "start": "pnpm run generate:css && pnpm run build && wrangler pages dev",
    "build": "pnpm run generate:css && ng build && pnpm run process",
    "watch": "pnpm run generate:css && ng build --watch --configuration development",
    "test": "ng test",
    "deploy": "pnpm run build && wrangler pages deploy",
    "process": "node ./tools/copy-files.mjs",
    "preview": "pnpm run build && wrangler dev",
    "serve:ssr:ng-material-enhanced": "node dist/ng-material-enhanced/server/server.mjs",
    "cf-typegen": "wrangler types"
  },
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.3",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.3",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.5",
    "@tanstack/highlight": "^0.0.10",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "wrangler": "^4.125.0"
  }
}
